; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Iron Tide: Coastal Assault"
config/description="Fast arcade run-and-gun shooter demo."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
Combat="*res://scripts/autoload/Combat.gd"
ObjectPool="*res://scripts/autoload/ObjectPool.gd"
Art="*res://scripts/autoload/Art.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
CameraShakeManager="*res://scripts/autoload/CameraShakeManager.gd"
CameraManager="*res://scripts/autoload/CameraManager.gd"
FX="*res://scripts/autoload/FX.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1000.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
