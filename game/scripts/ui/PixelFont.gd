class_name PixelFont
extends RefCounted
## 5x7 bitmap font baked into an outlined atlas at first use.
## `~` renders as an infinity sign, `>` as a chunky arrow.

const W := 5
const H := 7
const CELL := Vector2i(7, 9)
const ADVANCE := 6

const GLYPHS := {
	"A": ["01110", "10001", "10001", "11111", "10001", "10001", "10001"],
	"B": ["11110", "10001", "10001", "11110", "10001", "10001", "11110"],
	"C": ["01111", "10000", "10000", "10000", "10000", "10000", "01111"],
	"D": ["11110", "10001", "10001", "10001", "10001", "10001", "11110"],
	"E": ["11111", "10000", "10000", "11110", "10000", "10000", "11111"],
	"F": ["11111", "10000", "10000", "11110", "10000", "10000", "10000"],
	"G": ["01111", "10000", "10000", "10011", "10001", "10001", "01111"],
	"H": ["10001", "10001", "10001", "11111", "10001", "10001", "10001"],
	"I": ["11111", "00100", "00100", "00100", "00100", "00100", "11111"],
	"J": ["00111", "00010", "00010", "00010", "10010", "10010", "01100"],
	"K": ["10001", "10010", "10100", "11000", "10100", "10010", "10001"],
	"L": ["10000", "10000", "10000", "10000", "10000", "10000", "11111"],
	"M": ["10001", "11011", "10101", "10101", "10001", "10001", "10001"],
	"N": ["10001", "11001", "10101", "10011", "10001", "10001", "10001"],
	"O": ["01110", "10001", "10001", "10001", "10001", "10001", "01110"],
	"P": ["11110", "10001", "10001", "11110", "10000", "10000", "10000"],
	"Q": ["01110", "10001", "10001", "10001", "10101", "10010", "01101"],
	"R": ["11110", "10001", "10001", "11110", "10100", "10010", "10001"],
	"S": ["01111", "10000", "10000", "01110", "00001", "00001", "11110"],
	"T": ["11111", "00100", "00100", "00100", "00100", "00100", "00100"],
	"U": ["10001", "10001", "10001", "10001", "10001", "10001", "01110"],
	"V": ["10001", "10001", "10001", "10001", "10001", "01010", "00100"],
	"W": ["10001", "10001", "10001", "10101", "10101", "10101", "01010"],
	"X": ["10001", "10001", "01010", "00100", "01010", "10001", "10001"],
	"Y": ["10001", "10001", "01010", "00100", "00100", "00100", "00100"],
	"Z": ["11111", "00001", "00010", "00100", "01000", "10000", "11111"],
	"0": ["01110", "10011", "10101", "10101", "10101", "11001", "01110"],
	"1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
	"2": ["01110", "10001", "00001", "00110", "01000", "10000", "11111"],
	"3": ["11110", "00001", "00001", "01110", "00001", "00001", "11110"],
	"4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
	"5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
	"6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
	"7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
	"8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
	"9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
	"!": ["00100", "00100", "00100", "00100", "00100", "00000", "00100"],
	"?": ["01110", "10001", "00001", "00110", "00100", "00000", "00100"],
	".": ["00000", "00000", "00000", "00000", "00000", "00000", "00100"],
	",": ["00000", "00000", "00000", "00000", "00000", "00100", "01000"],
	":": ["00000", "00100", "00000", "00000", "00000", "00100", "00000"],
	"-": ["00000", "00000", "00000", "11111", "00000", "00000", "00000"],
	"+": ["00000", "00100", "00100", "11111", "00100", "00100", "00000"],
	"/": ["00001", "00010", "00010", "00100", "01000", "01000", "10000"],
	"'": ["00100", "00100", "01000", "00000", "00000", "00000", "00000"],
	"%": ["11001", "11010", "00010", "00100", "01000", "01011", "10011"],
	"(": ["00010", "00100", "01000", "01000", "01000", "00100", "00010"],
	")": ["01000", "00100", "00010", "00010", "00010", "00100", "01000"],
	">": ["01000", "01100", "11110", "11111", "11110", "01100", "01000"],
	"<": ["00010", "00110", "01111", "11111", "01111", "00110", "00010"],
	"*": ["00000", "10101", "01110", "11111", "01110", "10101", "00000"],
	"=": ["00000", "00000", "11111", "00000", "11111", "00000", "00000"],
	"x": ["00000", "00000", "10001", "01010", "00100", "01010", "10001"],
	"~": ["00000", "00000", "01010", "10101", "10101", "01010", "00000"],
	"#": ["01010", "11111", "01010", "01010", "01010", "11111", "01010"],
	" ": ["00000", "00000", "00000", "00000", "00000", "00000", "00000"],
}

static var _atlas: ImageTexture
static var _index: Dictionary = {}


static func _build() -> void:
	var keys := GLYPHS.keys()
	var img := Image.create(CELL.x * keys.size(), CELL.y, false, Image.FORMAT_RGBA8)
	for i in keys.size():
		var rows: Array = GLYPHS[keys[i]]
		_index[keys[i]] = i
		var ox := i * CELL.x + 1
		# outline pass
		for y in H:
			for x in W:
				if rows[y][x] == "1":
					for oy in range(-1, 2):
						for oxx in range(-1, 2):
							img.set_pixel(ox + x + oxx, 1 + y + oy, Color(0.06, 0.04, 0.08, 1))
		for y in H:
			for x in W:
				if rows[y][x] == "1":
					img.set_pixel(ox + x, 1 + y, Color.WHITE)
	_atlas = ImageTexture.create_from_image(img)


static func text_width(text: String, scale: int = 1) -> int:
	return text.length() * ADVANCE * scale


## Draws text on a CanvasItem during its _draw(). `pos` is the top-left corner.
static func draw_text(ci: CanvasItem, text: String, pos: Vector2, scale: int = 1, col: Color = Color.WHITE) -> void:
	if _atlas == null:
		_build()
	var x := pos.x
	for ch in text:
		var key: String = ch if GLYPHS.has(ch) else ch.to_upper()
		if not _index.has(key):
			key = "?"
		if key != " ":
			var i: int = _index[key]
			ci.draw_texture_rect_region(_atlas, Rect2(Vector2(x - scale, pos.y - scale), Vector2(CELL) * scale), Rect2(i * CELL.x, 0, CELL.x, CELL.y), col)
		x += ADVANCE * scale


static func draw_centered(ci: CanvasItem, text: String, center: Vector2, scale: int = 1, col: Color = Color.WHITE) -> void:
	var w := text_width(text, scale)
	draw_text(ci, text, Vector2(round(center.x - w * 0.5), round(center.y - H * scale * 0.5)), scale, col)


## Paints a glyph into a PixelCanvas (used by Art for crate letters, etc).
static func paint_glyph(c: PixelCanvas, ch: String, x: int, y: int, col: Color) -> void:
	if not GLYPHS.has(ch):
		return
	var rows: Array = GLYPHS[ch]
	for yy in H:
		for xx in W:
			if rows[yy][xx] == "1":
				c.px(x + xx, y + yy, col)


static func paint_text(c: PixelCanvas, text: String, x: int, y: int, col: Color) -> void:
	for i in text.length():
		paint_glyph(c, text[i], x + i * ADVANCE, y, col)
