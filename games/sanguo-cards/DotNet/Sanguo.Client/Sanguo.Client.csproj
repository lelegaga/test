<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile check for the Unity-facing scripts (Assets/Scripts/App, asmdef Sanguo.Client) against
    UnityEngine reference assemblies from NuGet (Unity 2021.3 API surface; Unity 6 is a superset for
    the APIs used here). Real builds are done by the Unity editor.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Sanguo.Client</AssemblyName>
    <RootNamespace>Sanguo.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- UGUI (UnityEngine.UI) is a Unity package, not a module: download it and reference the DLL directly. -->
    <PackageDownload Include="Unity3D.UnityEngine.UI" Version="[2020.3.21]" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NuGetPackageRoot)unity3d.unityengine.ui/2020.3.21/lib/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sanguo.Core\Sanguo.Core.csproj" />
    <ProjectReference Include="..\Sanguo.Network\Sanguo.Network.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)Scripts\App\**\*.cs" />
    <Compile Include="$(UnityAssets)Scripts\UI\**\*.cs" />
    <Compile Include="$(UnityAssets)Scripts\Audio\**\*.cs" />
  </ItemGroup>
</Project>
