<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless build of the Sanguo.Network assembly (Assets/Scripts/Network, pure C#). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Sanguo.Network</AssemblyName>
    <RootNamespace>Sanguo.Network</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sanguo.Core\Sanguo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)Scripts\Network\**\*.cs" />
  </ItemGroup>
</Project>
