<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless simulator: plays bot games with the real engine and prints the game log / statistics. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>sanguo-sim</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sanguo.Core\Sanguo.Core.csproj" />
  </ItemGroup>
</Project>
